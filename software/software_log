    Middleware Integration Steps on Existing Petalinux System
    
      Prepare Your Development Host
      
        Install ZeroMQ and MQTT dependencies on the host:
        
          sudo apt update
          sudo apt install libzmq3-dev libczmq-dev libmosquitto-dev mosquitto-clients
          
        Install the SDK on Host
                  
          petalinux-build --sdk #This generates an sdk.sh installer in images/linux/
          cd <petalinux_project>/images/linux/
          chmod +x sdk.sh
          ./sdk.sh   # this will install petalinux 
          
          *petalinux-build command failed after this. Had to discard changes in this branch after installing sdk in 
          /tools/Xilinx/Petalinux/2024.2/sdk to return to petalinux setting in integration
          
          source /tools/Xilinx/Petalinux/2024.2/sdk/environment-setup-cortexa72-cortexa53-xilinx-linux   

        Cross-Compiling ZeroMQ
        
          cd libzmq
          mkdir build && cd build
          cmake .. \
          -DCMAKE_INSTALL_PREFIX=$SDKTARGETSYSROOT/usr \
          -DCMAKE_C_COMPILER=aarch64-xilinx-linux-gcc \
          -DCMAKE_CXX_COMPILER=aarch64-xilinx-linux-g++ \
          -DCMAKE_SYSROOT=$SDKTARGETSYSROOT \
          -DCMAKE_FIND_ROOT_PATH=$SDKTARGETSYSROOT \
          -DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER \
          -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY \
          -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY \
          -DWITH_PERF_TOOL=OFF
     
    
